{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BoomTimer",
  "version": "1.0.0",
  "identifier": "com.boomtimer.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BoomTimer",
        "url": "index.html",
        "width": 420,
        "height": 660,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#0e1116",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "上班族解压定时器",
    "longDescription": "时间一到，一颗炸弹在屏幕中央炸开，整块屏幕跟着抖三抖。",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}