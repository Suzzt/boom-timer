{
  "name": "boom-timer",
  "productName": "BoomTimer",
  "version": "1.0.0",
  "description": "上班族解压定时器 —— 时间一到，屏幕炸给你看",
  "main": "src/main/main.js",
  "author": "BoomTimer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist:mac": "npm run icon && electron-builder --mac",
    "dist:win": "npm run icon && electron-builder --win",
    "dist": "npm run icon && electron-builder --mac --win"
  },
  "build": {
    "appId": "com.boomtimer.app",
    "productName": "BoomTimer",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/renderer/_preview.html",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "extendInfo": {
        "NSSupportsAutomaticGraphicsSwitching": true
      }
    },
    "dmg": {
      "title": "BoomTimer"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BoomTimer"
    },
    "afterPack": "scripts/after-pack.js",
    "compression": "maximum"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}